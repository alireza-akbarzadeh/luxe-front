# Copy to .env.test.local (gitignored) for local E2E runs.

# App under test (Playwright baseURL)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Backend API (must match NEXT_PUBLIC_API_URL for Server Actions)
PLAYWRIGHT_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Browser install (geo-restricted regions) ---
# Option A: mirror (auto-tried by pnpm run test:install)
# PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
# PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/chrome-for-testing

# Option B: skip download, use installed Google Chrome
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# PLAYWRIGHT_USE_SYSTEM_CHROME=1

# --- Integration tests (real API + seeded user) ---
# E2E_INTEGRATION=1
# E2E_USER_EMAIL=test@example.com
# E2E_USER_PASSWORD=Test123!
