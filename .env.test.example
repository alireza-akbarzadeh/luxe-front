# Copy to .env.test.local (gitignored) for local E2E runs.

# App under test (Playwright baseURL)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Backend API (must match NEXT_PUBLIC_API_URL for Server Actions)
PLAYWRIGHT_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Used by `pnpm api:gen` / Vercel prebuild (OpenAPI lives at {base}/openapi)
# OPENAPI_BASE_URL=https://luxe-3pvz.onrender.com

# Optional: override WebSocket URL (defaults to ws://host/api/v1/ws/connect from API URL)
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws/connect

# Set to true to run the live sales dashboard with local mock data (no backend WS)
# NEXT_PUBLIC_SALES_FEED_MOCK=true

# --- Browser install (geo-restricted regions) ---
# Option A: mirror (auto-tried by pnpm run test:install)
# PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
# PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/chrome-for-testing

# Option B (recommended when CDN returns 403): use installed Google Chrome
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
PLAYWRIGHT_USE_SYSTEM_CHROME=1

# --- Integration tests (real API + seeded user) ---
# E2E_INTEGRATION=1
# E2E_USER_EMAIL=test@example.com
# E2E_USER_PASSWORD=Test123!
