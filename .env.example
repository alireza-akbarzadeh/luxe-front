# Local development — copy to .env.local
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
BACKEND_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production values live in .env.production (Render API + Vercel storefront).
# On Vercel, also set these in Project → Settings → Environment Variables.

# Sentry (optional in local dev — avoids Turbopack instrumentation cache glitches)
# SENTRY_ENABLE_DEV=true
# NEXT_PUBLIC_SENTRY_ENABLE_DEV=true
# SENTRY_AUTH_TOKEN=...  # CI / source map upload only — never commit real tokens


R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=luxe-media
R2_PUBLIC_BASE_URL=https://pub-abc123.r2.dev
# R2_ENDPOINT is optional — auto-set from account ID
R2_PRESIGN_TTL=15m
R2_MAX_UPLOAD_MB=10