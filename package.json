  "scripts": {
    "prepare": "husky",
    "postinstall": "node scripts/playwright-install.mjs",
    "start": "next start",
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "node scripts/prebuild.mjs && next build",
    "preview": "next start",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint:fix",
    "api:gen": "node ./code-generator.js && npx orval --config ./src/services/orval.config.js",
    "openapi:sync": "node scripts/openapi-sync.mjs",
    "lint:fix": "eslint --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"**/**/*.{html,css,scss,js,jsx,cjs,mjs,ts,tsx,mdx}\" --cache",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "playwright test --ui",
    "test:install": "node scripts/playwright-install.mjs",
    "test:smoke": "playwright test --grep @smoke",
    "test:auth": "playwright test --grep @auth",
    "test:integration": "E2E_INTEGRATION=1 playwright test --grep @integration"
  },
